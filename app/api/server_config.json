{
    "servers": {
        "database": {
            "command": "uv",
            "args": [
                "run", 
                "-m",
                "app.api.servers.database.database_server"
            ],
            "env": {
                "DATABASE_PATH": "${DATABASE_PATH}"
            }
        },
        "files": {
            "command": "uv",
            "args": [
                "run", 
                "-m",
                "app.api.servers.files.files_server"]
        }
    }
}